			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function(){\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Token field is present\", function(){\r",
							"    pm.expect(pm.response.json()).to.have.property(\"token\");\r",
							"});\r",
							"\r",
							"pm.test(\"Token is alphanumeric\", function () {\r",
							"    var token = pm.response.json().token;\r",
							"    pm.expect(token).to.match(/^[A-Za-z0-9]+$/);\r",
							"});\r",
							"\r",
							"pm.test(\"Response time is under 1 second\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
							"});\r",
							""
						],
