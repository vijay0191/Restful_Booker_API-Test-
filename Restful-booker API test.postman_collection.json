		{
			"name": "Get Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", () => {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response has all booking fields\", () => {\r",
							"    const json = pm.response.json();\r",
							"    pm.expect(json).to.have.property(\"firstname\");\r",
							"    pm.expect(json).to.have.property(\"lastname\");\r",
							"    pm.expect(json).to.have.property(\"totalprice\");\r",
							"    pm.expect(json).to.have.property(\"depositpaid\");\r",
							"    pm.expect(json).to.have.property(\"bookingdates\");\r",
							"    pm.expect(json).to.have.property(\"additionalneeds\")\r",
							"});\r",
							"\r",
							"pm.test(\"Response time under 2000ms\", ()=>{\r",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
							"})\r",
							"\r",
							"pm.test(\"Response is valid JSON\", () => {\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"const schema = {\r",
							"    \"type\": \"object\",\r",
							"    \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],\r",
							"    \"properties\": {\r",
							"        \"firstname\": { \"type\": \"string\" },\r",
							"        \"lastname\": { \"type\": \"string\" },\r",
							"        \"totalprice\": { \"type\": \"number\" },\r",
							"        \"depositpaid\": { \"type\": \"boolean\" },\r",
							"        \"bookingdates\": {\r",
							"            \"type\": \"object\",\r",
							"            \"required\": [\"checkin\", \"checkout\"],\r",
							"            \"properties\": {\r",
							"                \"checkin\": { \"type\": \"string\" },\r",
							"                \"checkout\": { \"type\": \"string\" }\r",
							"            }\r",
							"        },\r",
							"        \"additionalneeds\": { \"type\": \"string\" }\r",
							"    }\r",
							"};\r",
							"\r",
							"pm.test(\"JSON schema is valid\", () => {\r",
							"    pm.expect(tv4.validate(pm.response.json(), schema)).to.be.true;\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
